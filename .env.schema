# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_SERVICE_ACCOUNT_TOKEN, useCliWithServiceAccount=true)
# ---

# 1Password service-account token supplied by the local host or CI environment.
# @type=opServiceAccountToken @sensitive @internal @required
OP_SERVICE_ACCOUNT_TOKEN=

# Jev API key used for evaluations.
# @sensitive @required
JEVLINT_TYPESAFE_API_KEY=op(op://van-tonder-nosudo/typesafe-api-key/credential)
