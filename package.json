{
  "name": "jevlint",
  "version": "0.1.0",
  "description": "Probabilistic code review powered by Jev and Oxc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drevantonder/jevlint.git"
  },
  "homepage": "https://github.com/drevantonder/jevlint#readme",
  "bugs": {
    "url": "https://github.com/drevantonder/jevlint/issues"
  },
  "keywords": [
    "code-review",
    "static-analysis",
    "cli",
    "typescript",
    "jev",
    "typesafe"
  ],
  "type": "module",
  "bin": {
    "jevlint": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "check": "tsc --noEmit && node tools/generate-registry.mjs --check && vitest run",
    "generate:registry": "node tools/generate-registry.mjs",
    "jevlint": "node dist/cli.js",
    "lint": "oxlint",
    "test": "vitest run",
    "test:live": "RUN_LIVE_JEV=1 vitest run test/live",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "jiti": "^2.6.1",
    "oxc-parser": "^0.150.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.83.0",
    "@types/node": "^24.10.0",
    "oxlint": "1.83.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@11.3.0"
}
